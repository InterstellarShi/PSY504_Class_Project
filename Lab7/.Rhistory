library(effects)
effect(term = "audio*headphones", mod = sdmt_mod) |>
as.data.frame()
sdmt_mod <- lmerTest::lmer(SDMT ~ audio * headphones +
(1 + audio | PID), data = efdat)
summary(sdmt_mod)
#| eval: false
library(effects)
effect(term = "audio*headphones", mod = sdmt_mod) |>
as.data.frame()
